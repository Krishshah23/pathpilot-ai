# ── Django ─────────────────────────────────────────────
# DJANGO_SECRET_KEY and INTERNAL_API_KEY below are placeholder values only —
# the app will refuse to start with DEBUG=False while either is left as the
# literal string shown here. Generate real random values for any deployment.
DJANGO_SECRET_KEY=change_me_to_a_long_random_string
# Local dev only — omit this var (or set it to False) in any real deployment;
# it now defaults to False (off) if unset.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Only the Node backend origin may call this service.
CORS_ALLOWED_ORIGINS=http://localhost:5000

# Shared secret — must match INTERNAL_API_KEY on the Node backend. Change
# this from the placeholder before deploying.
INTERNAL_API_KEY=dev-internal-key
